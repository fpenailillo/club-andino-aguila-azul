generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// CATEGORÍAS DE SOCIOS (Activo 100%, Vitalicio C 60%, Activo prepago 88%, etc.)
// ============================================================================

model Categoria {
  id              Int     @id @default(autoincrement())
  nombre          String  @unique
  porcentajeCuota Decimal @default(100) @db.Decimal(5, 2) @map("porcentaje_cuota")
  activo          Boolean @default(true)

  socios Socio[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([activo])
  @@map("categorias")
}

// ============================================================================
// SOCIOS
// ============================================================================

model Socio {
  id             Int         @id @default(autoincrement())
  nombre         String
  apPaterno      String?     @map("ap_paterno")
  apMaterno      String?     @map("ap_materno")
  nombreCompleto String      @map("nombre_completo")
  rut            String?     @unique
  email          String?     @unique
  telefono       String?
  direccion      String?
  fechaNacimiento DateTime?  @map("fecha_nacimiento")
  fechaIngreso   DateTime    @default(now()) @map("fecha_ingreso")
  acta           String?
  fechaExSocio   DateTime?   @map("fecha_ex_socio")
  notas          String?     @db.Text
  estado         EstadoSocio @default(ACTIVO)

  categoriaId Int?       @map("categoria_id")
  categoria   Categoria? @relation(fields: [categoriaId], references: [id])

  movimientos Movimiento[]
  credencial  Credencial?
  reservas    Reserva[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nombreCompleto])
  @@index([email])
  @@index([estado])
  @@index([categoriaId])
  @@map("socios")
}

enum EstadoSocio {
  ACTIVO
  HONORARIO
  CONGELADO
  COOPERADOR
  RENUNCIADO
  ELIMINADO
  FALLECIDO
}

// ============================================================================
// CREDENCIAL DIGITAL DEL CLUB
// ============================================================================

model Credencial {
  id           Int      @id @default(autoincrement())
  socioId      Int      @unique @map("socio_id")
  socio        Socio    @relation(fields: [socioId], references: [id])
  codigo       String   @unique // Ej: "CAA-2026-00042"
  anioVigencia Int      @map("anio_vigencia")
  activa       Boolean  @default(true)
  emitidaEn   DateTime @default(now()) @map("emitida_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([codigo])
  @@index([anioVigencia])
  @@index([activa])
  @@map("credenciales")
}

// ============================================================================
// RESERVAS DEL REFUGIO
// ============================================================================

model Reserva {
  id            Int           @id @default(autoincrement())
  socioId       Int           @map("socio_id")
  socio         Socio         @relation(fields: [socioId], references: [id])
  fechaDesde    DateTime      @map("fecha_desde")
  fechaHasta    DateTime      @map("fecha_hasta")
  nPersonas     Int           @default(1) @map("n_personas")
  comentario    String?       @db.Text
  estado        EstadoReserva @default(PENDIENTE)
  motivoRechazo String?       @map("motivo_rechazo") @db.Text
  revisadoPor   String?       @map("revisado_por")
  revisadoEn    DateTime?     @map("revisado_en")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([socioId])
  @@index([estado])
  @@index([fechaDesde])
  @@map("reservas")
}

enum EstadoReserva {
  PENDIENTE
  APROBADA
  RECHAZADA
  CANCELADA
}

// ============================================================================
// CONCEPTOS
// ============================================================================

model Concepto {
  id          Int            @id @default(autoincrement())
  nombre      String         @unique
  tipo        TipoMovimiento
  descripcion String?        @db.Text
  activo      Boolean        @default(true)

  movimientos Movimiento[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tipo])
  @@index([activo])
  @@map("conceptos")
}

// ============================================================================
// CENTROS DE COSTO
// ============================================================================

model Centro {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String? @db.Text
  activo      Boolean @default(true)

  movimientos Movimiento[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([activo])
  @@map("centros")
}

// ============================================================================
// MOVIMIENTOS (Ingresos, Egresos, Cargos y Abonos)
// ============================================================================

model Movimiento {
  id             Int            @id @default(autoincrement())
  numeroRegistro String         @unique @map("numero_registro")
  tipo           TipoMovimiento

  socioId Int?   @map("socio_id")
  socio   Socio? @relation(fields: [socioId], references: [id])

  conceptoId Int      @map("concepto_id")
  concepto   Concepto @relation(fields: [conceptoId], references: [id])

  centroId Int    @map("centro_id")
  centro   Centro @relation(fields: [centroId], references: [id])

  comentario     String  @db.Text
  monto          Decimal @db.Decimal(12, 2)
  fecha          DateTime

  // Solo para INGRESO/EGRESO sin socio asignado
  esSinSocio     Boolean @default(false) @map("es_sin_socio")
  motivoSinSocio String? @map("motivo_sin_socio")

  creadoPor     String? @map("creado_por")
  modificadoPor String? @map("modificado_por")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tipo])
  @@index([socioId])
  @@index([conceptoId])
  @@index([centroId])
  @@index([fecha])
  @@index([numeroRegistro])
  @@index([esSinSocio])
  @@map("movimientos")
}

enum TipoMovimiento {
  INGRESO
  EGRESO
  CARGO  // Cargo a cuenta del socio (deuda)
  ABONO  // Abono a cuenta del socio (pago)
}

// ============================================================================
// USUARIOS DEL SISTEMA
// ============================================================================

model Usuario {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  nombre       String
  passwordHash String     @map("password_hash")
  rol          RolUsuario @default(USUARIO)
  activo       Boolean    @default(true)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  lastLogin DateTime? @map("last_login")

  @@index([email])
  @@index([activo])
  @@map("usuarios")
}

enum RolUsuario {
  ADMIN
  TESORERO
  USUARIO
  SOCIO // Portal de socios (acceso restringido)
}

// ============================================================================
// CONTADOR DE REGISTROS (para números de registro únicos)
// ============================================================================

model ContadorRegistro {
  id     Int            @id @default(autoincrement())
  tipo   TipoMovimiento @unique
  ultimo Int            @default(0)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("contadores_registro")
}
