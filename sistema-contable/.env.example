# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/club_andino_contable"

# NextAuth v5 — generar AUTH_SECRET con: openssl rand -base64 32
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth (Google Workspace del club)
# Obtener en: console.cloud.google.com → APIs → Credenciales → Crear credencial → ID de cliente OAuth 2.0
AUTH_GOOGLE_ID="your-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-client-secret"
